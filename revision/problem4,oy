def count_positive(numbers):
    count=0
    for num in numbers:
        if num >0:
            count+=1
        elif num==0:
            continue
        # elif numbers==[]:
        #     return 0
    return count

print(count_positive([1, -2, 3, 0, 5]))
print(count_positive([-1, -5, 0]))
print(count_positive([4, 2, 8]))
print(count_positive([]))